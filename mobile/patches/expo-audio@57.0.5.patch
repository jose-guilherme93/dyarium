+        factory,
+        DefaultExtractorsFactory()
+          .setAdtsExtractorFlags(AdtsExtractor.FLAG_ENABLE_CONSTANT_BITRATE_SEEKING)
+      )
       else -> throw IllegalStateException("Unsupported type: $type")
     }.createMediaSource(mediaItem)
   }
