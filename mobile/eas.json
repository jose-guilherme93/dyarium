{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_rnllamaVariants": "rnllama_v8_2,rnllama_v8_2_dotprod_i8mm"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ANALYSIS_BENCHMARK": "1",
        "ORG_GRADLE_PROJECT_rnllamaVariants": "rnllama_v8_2,rnllama_v8_2_dotprod_i8mm"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
