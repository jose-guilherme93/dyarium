{
  "name": "dyarium",
  "version": "0.2.0",
  "font": {
    "family": "Schibsted Grotesk",
    "stack": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "monoStack": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "web": {
      "latin": "schibsted-grotesk.woff2",
      "latin-ext": "schibsted-grotesk-ext.woff2"
    },
    "mobile": {
      "medium": "SchibstedGrotesk-Medium.ttf",
      "semibold": "SchibstedGrotesk-SemiBold.ttf"
    },
    "license": "SIL Open Font License 1.1"
  },
  "type": {
    "greeting": { "size": 48, "weight": 600, "lineHeight": 1.05, "letterSpacing": "-0.025em" },
    "clock": { "size": 40, "weight": 600, "lineHeight": 1.05, "letterSpacing": "0.01em", "tabular": true, "mono": true },
    "display": { "size": 21, "weight": 600, "lineHeight": 1.2, "letterSpacing": "-0.01em" },
    "title": { "size": 17, "weight": 600, "lineHeight": 1.3, "letterSpacing": "-0.005em" },
    "body": { "size": 13, "weight": 500, "lineHeight": 1.32, "letterSpacing": "0" },
    "label": { "size": 10, "weight": 500, "lineHeight": 1.2, "letterSpacing": "0.12em", "uppercase": true },
    "mono": { "size": 11.5, "weight": 500, "lineHeight": 1.2, "letterSpacing": "0.02em", "tabular": true }
  },
  "reading": {
    "family": "Newsreader",
    "stack": "\"Newsreader\", Georgia, serif",
    "size": 15,
    "weight": 400,
    "lineHeight": 1.45,
    "measure": 44,
    "license": "SIL Open Font License 1.1",
    "note": "Corpo de livro e leitura longa. A medida e em caracteres, nao em pixels."
  },
  "space": [2, 4, 6, 8, 12, 16, 24, 32],
  "radius": { "control": 2, "surface": 3 },
  "focus": { "width": 1, "offset": 2, "color": "primary" },
  "control": { "sm": 20, "md": 26, "lg": 30, "padX": { "sm": 7, "md": 9, "lg": 12 } },
  "meter": { "height": 2, "gap": 8, "compose": 44 },
  "row": { "touch": 44, "dense": 26 },
  "tree": { "cell": 14, "rail": 6, "guide": 1 },
  "mark": { "size": 8, "stroke": 1.5, "tick": 4 },
  "chart": {
    "height": 84, "top": 8, "base": 64, "labels": 78,
    "barMin": 3, "colMin": 5, "colMax": 16, "colRatio": 0.52,
    "sessionMin": 10, "sessionBarMin": 6
  },
  "icon": {
    "sm": 12,
    "md": 14,
    "lg": 24,
    "box": 16,
    "stroke": 1.5,
    "strokeDetail": 1.3,
    "glyphs": "docs/design/icons.json"
  },
  "layout": {
    "page": 420,
    "measure": 58,
    "gutter": 24,
    "sidebar": 238,
    "rail": 34,
    "toolbar": 34,
    "tab": 26,
    "spread": 520,
    "phone": 324
  },
  "layer": {
    "content": 0,
    "rail": 1,
    "toolbar": 2,
    "sheet": 40,
    "dialog": 50,
    "notice": 60,
    "tooltip": 70
  },
  "motion": {
    "fast": 90,
    "base": 160,
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "note": "Movimento so para state. Nada decorativo, nada que atrase a leitura."
  },
  "notice": { "dwell": 6000 },
  "wave": {
    "height": 44,
    "bar": 1.5,
    "gap": 1,
    "min": 2,
    "idle": 0.26,
    "played": 1
  },
  "state": {
    "bar": 2,
    "disabled": 0.45,
    "note": "Desabilitado usa opacidade e cor de texto apagada; selecionado usa degrau tonal e barra de 2px."
  },
  "palettes": {
    "light": {
      "surface": "#eceee9",
      "surface-alt": "#e3e6e0",
      "surface-raised": "#dadfd7",
      "line": "#d2d6cf",
      "text": "#232622",
      "text-muted": "#6a6f68",
      "primary": "#5b6f66",
      "primary-soft": "#dce3e0",
      "danger": "#9c6259",
      "success": "#5c7a63",
      "warning": "#8b7444",
      "info": "#5a6f80",
      "overlay": "rgba(0,0,0,0.18)"
    },
    "dark": {
      "surface": "#171a18",
      "surface-alt": "#1f2320",
      "surface-raised": "#272c28",
      "line": "#2f3431",
      "text": "#e4e8e3",
      "text-muted": "#a1a8a2",
      "primary": "#a2b8ae",
      "primary-soft": "#2a3431",
      "danger": "#c78f85",
      "success": "#94b09a",
      "warning": "#c6ab77",
      "info": "#9ab3c4",
      "overlay": "rgba(0,0,0,0.45)"
    },
    "amoled": {
      "surface": "#000000",
      "surface-alt": "#0b0d0c",
      "surface-raised": "#151817",
      "line": "#242826",
      "text": "#e4e8e3",
      "text-muted": "#9aa198",
      "primary": "#a2b8ae",
      "primary-soft": "#1e2624",
      "danger": "#c78f85",
      "success": "#94b09a",
      "warning": "#c6ab77",
      "info": "#9ab3c4",
      "overlay": "rgba(0,0,0,0.55)"
    }
  },
  "rules": [
    "Cor so significa estado. Nenhuma cor decorativa.",
    "Estado aparece por forma antes de cor: disco preenchido feito, anel vazio nao feito, anel com traco ficou de fora.",
    "Sem sombra difusa, sem gradiente, sem brilho. Separacao por hairline de 1px e degrau tonal.",
    "Raio 2 em controle, 3 em superficie. Nada acima de 4. Sem pilula, exceto o disco de gravacao e o FAB, que sao circulares por funcao.",
    "Foco e contorno de 1px com offset de 2px, nunca anel grosso nem sombra.",
    "Peso 600 so em display, titulo, saudacao e relogio. Corpo e rotulo em 500. Nada em 700.",
    "Texto visivel so para nome de nota, rotulo de 1 a 3 palavras, numero e erro acionavel.",
    "Explicacao mora atras de um toque, nunca em paragrafo na tela.",
    "Resumo de analise e dado, nao copy: no maximo duas frases, sempre dos numeros calculados sem LLM.",
    "Leitura longa e serifada e medida em 44 caracteres; todo o resto e sans.",
    "A tela migrada mostra tudo que a tela atual mostra: data, hora, pausa, filtros e menus continuam.",
    "Nenhum emoji em codigo, interface, log ou documentacao."
  ]
}
