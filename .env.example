# Copie para .env e ajuste os valores. Nenhum segredo real deve ser versionado.

# --- servidor ---
DIARY_HTTP_ADDR=:8080
# Opcionais: se vazios, a chave mestra e o token sao gerados no primeiro boot e
# guardados em /data (master.key e token). O token tambem pode ser definido na
# tela de primeiro acesso do dashboard (/setup).
DIARY_TOKEN=
DIARY_MASTER_KEY=
DIARY_LOG_LEVEL=info

# --- armazenamento ---
DIARY_DB_PATH=data/diary.db
DIARY_DATA_DIR=data

# --- transcricao ---
DIARY_MODELS_DIR=models
DIARY_MODELS_BASE_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main
DIARY_WHISPER_BIN=whisper-cli
DIARY_WHISPER_MODEL=models/ggml-small-q5_1.bin
# Baixa o modelo padrao no primeiro boot quando ele ainda nao existe
DIARY_AUTO_DOWNLOAD_MODEL=true
# Idioma da transcricao (vazio = detectar automaticamente; ex.: pt, en, es)
DIARY_WHISPER_LANGUAGE=
DIARY_FFMPEG_BIN=ffmpeg
DIARY_FFPROBE_BIN=ffprobe
DIARY_TRIM_SILENCE=false
DIARY_WORKER_CONCURRENCY=1
DIARY_JOB_LEASE_SECONDS=120
# Worker opcional do dashboard: o PC do usuario assume transcribe/analyze
# enquanto a aba /lab estiver aberta. Sem worker registrado nada muda.
DIARY_BROWSER_WORKER=true
DIARY_MAX_UPLOAD_BYTES=2147483648
DIARY_MAX_DURATION_SECONDS=3000
DIARY_ALLOWED_FORMATS=wav,mp3,m4a,ogg,flac,aac,adts
# Quanto tempo uma entrada apagada continua recuperavel (POST /entries/{id}/restore).
DIARY_DELETED_RETENTION_HOURS=168
# Limite de RAM (MB) para o subprocesso de transcricao; 0 = sem limite
DIARY_MAX_WHISPER_RSS_MB=0

# --- analise por IA (opcional) ---
DIARY_ANALYZE_ENABLED=false
DIARY_ANALYZE_BASE_URL=http://localhost:11434/v1
DIARY_ANALYZE_API_KEY=
DIARY_ANALYZE_MODEL=
# Ollama local: no compose o servico se chama ollama e o painel configura sozinho.
DIARY_OLLAMA_URL=http://ollama:11434
DIARY_OLLAMA_MODEL=qwen2.5:0.5b
# llama.cpp embutido: o binario vem na imagem e o GGUF e baixado pelo painel.
# O modelo so fica na memoria durante a analise (idle em segundos, 0 desliga).
DIARY_LLAMA_SERVER_BIN=llama-server
DIARY_LLAMA_PORT=11435
DIARY_LLAMA_THREADS=2
DIARY_LLAMA_IDLE_SECONDS=300
DIARY_LLAMA_MODEL=qwen2.5-0.5b-instruct-q4_k_m

# --- telegram (opcional) ---
DIARY_TELEGRAM_ENABLED=false
DIARY_TELEGRAM_BOT_TOKEN=
# Base da API do Telegram (informe quando habilitar o modulo)
DIARY_TELEGRAM_API_BASE=

# --- litestream (opcional) ---
DIARY_LITESTREAM_ENABLED=false
DIARY_LITESTREAM_BUCKET=
DIARY_LITESTREAM_PATH=dyarium
DIARY_LITESTREAM_ENDPOINT=
DIARY_LITESTREAM_ACCESS_KEY_ID=
DIARY_LITESTREAM_SECRET_ACCESS_KEY=
